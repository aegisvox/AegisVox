{
  "name": "GemmaLive Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "20",
      "pnpm": "latest",
      "nvm": "latest"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y espeak-ng ffmpeg && pip install -r backend/requirements.txt && npm install",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Frontend",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "FastAPI AI Backend",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}